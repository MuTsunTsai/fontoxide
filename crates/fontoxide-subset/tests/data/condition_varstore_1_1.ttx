        </Feature>
      </FeatureRecord>
      <FeatureRecord index="1">
        <FeatureTag value="rvrn"/>
        <Feature>
          <!-- LookupCount=0 -->
        </Feature>
      </FeatureRecord>
    </FeatureList>
    <LookupList>
      <!-- LookupCount=2 -->
      <Lookup index="0">
        <LookupType value="1"/>
        <LookupFlag value="0"/>
        <!-- SubTableCount=1 -->
        <SingleSubst index="0">
          <Substitution in="dollar" out="dollar.rvrn"/>
        </SingleSubst>
      </Lookup>
      <Lookup index="1">
        <LookupType value="4"/>
        <LookupFlag value="0"/>
        <!-- SubTableCount=1 -->
        <LigatureSubst index="0">
          <LigatureSet glyph="f">
            <Ligature components="f" glyph="f_f"/>
          </LigatureSet>
        </LigatureSubst>
      </Lookup>
    </LookupList>
    <FeatureVariations>
      <Version value="0x00010001"/>
      <!-- FeatureVariationCount=0 -->
      <!-- LookupVariationCount=1 -->
      <LookupVariationRecord index="0">
        <FeatureIndex value="1"/>
        <FeatureLookupsTable>
          <Version value="0x00010000"/>
          <Flags value="1"/>
          <!-- LookupConditionCount=1 -->
          <LookupConditionRecord index="0">
            <ConditionTable Format="3">
              <!-- ConditionCount=2 -->
              <ConditionTable index="0" empty="1"/>
              <ConditionTable index="1" Format="5">
                <ConditionTable Format="2">
                  <DefaultValue value="-1"/>
                  <VarIdx value="1"/>
                </ConditionTable>
              </ConditionTable>
            </ConditionTable>
            <LookupIndexList>
              <!-- LookupIndexCount=1 -->
              <LookupIndex index="0" value="1"/>
            </LookupIndexList>
          </LookupConditionRecord>
        </FeatureLookupsTable>
