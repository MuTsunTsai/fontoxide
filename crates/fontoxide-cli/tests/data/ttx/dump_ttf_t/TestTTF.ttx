         will be recalculated by the compiler. -->

    <TTGlyph name=".notdef" xMin="50" yMin="0" xMax="450" yMax="750">
      <contour>
        <pt x="50" y="0" on="1"/>
        <pt x="50" y="750" on="1"/>
        <pt x="450" y="750" on="1"/>
        <pt x="450" y="0" on="1"/>
