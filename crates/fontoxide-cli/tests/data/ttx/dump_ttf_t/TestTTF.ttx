        <pt x="400" y="700" on="1"/>
        <pt x="100" y="700" on="1"/>
        <pt x="100" y="50" on="1"/>
      </contour>
      <instructions>
        <assembly>
          SVTCA[0]	/* SetFPVectorToAxis */
          SVTCA[1]	/* SetFPVectorToAxis */
        </assembly>
      </instructions>
    </TTGlyph>

    <TTGlyph name=".null"/><!-- contains no outline data -->

