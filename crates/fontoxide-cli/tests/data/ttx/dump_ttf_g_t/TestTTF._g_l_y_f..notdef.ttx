<?xml version="1.0" encoding="UTF-8"?>
<ttFont ttLibVersion="4.68">
  <glyf>
    <!-- The xMin, yMin, xMax and yMax values
         will be recalculated by the compiler. -->
    <TTGlyph name=".notdef" xMin="50" yMin="0" xMax="450" yMax="750">
      <contour>
        <pt x="50" y="0" on="1"/>
        <pt x="50" y="750" on="1"/>
        <pt x="450" y="750" on="1"/>
        <pt x="450" y="0" on="1"/>
      </contour>
      <contour>
        <pt x="400" y="50" on="1"/>
        <pt x="400" y="700" on="1"/>
        <pt x="100" y="700" on="1"/>
        <pt x="100" y="50" on="1"/>
      </contour>
      <instructions>
        <assembly>
          SVTCA[0]	/* SetFPVectorToAxis */
          SVTCA[1]	/* SetFPVectorToAxis */
        </assembly>
      </instructions>
    </TTGlyph>
  </glyf>
</ttFont>
