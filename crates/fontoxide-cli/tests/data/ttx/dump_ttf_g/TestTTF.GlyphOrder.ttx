    <GlyphID id="1" name=".null"/>
    <GlyphID id="2" name="CR"/>
    <GlyphID id="3" name="space"/>
    <GlyphID id="4" name="period"/>
    <GlyphID id="5" name="ellipsis"/>
  </GlyphOrder>

</ttFont>
